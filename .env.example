TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nomus_kz_legal_v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RELEVANCE_THRESHOLD=0.35
DB_PATH=./data/nomus.db
LOG_LEVEL=INFO

# Веб-часть
BOT_USERNAME=nomus_law_bot
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
RATE_LIMIT_PER_HOUR=30
# Включить, если сайт публикуется через cloudflared / nginx (иначе rate limit
# посчитает всех посетителей одним клиентом)
TRUSTED_PROXY=false
